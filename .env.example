AGENTFLOW_LLM_API_KEY=replace_with_your_api_key
AGENTFLOW_LLM_BASE_URL=https://api.deepseek.com
AGENTFLOW_LLM_MODEL=deepseek-chat
AGENTFLOW_TOOL_CALLING_ENABLED=false
AGENTFLOW_LLM_TIMEOUT_SECONDS=30
# Set false to use the historical deterministic evidence verifier.
AGENTFLOW_LLM_VERIFIER_ENABLED=true
AGENTFLOW_MAX_RETRIEVAL_QUERIES=7
AGENTFLOW_MAX_FOLLOW_UP_QUERIES=2
AGENTFLOW_MAX_RETRIEVAL_DURATION_MS=30000
AGENTFLOW_MAX_NO_PROGRESS_ROUNDS=1
AGENTFLOW_QUERY_SIMILARITY_THRESHOLD=0.95
# Pricing changes over time. Fill these from your provider's current price page.
AGENTFLOW_INPUT_COST_PER_MILLION_USD=0
AGENTFLOW_OUTPUT_COST_PER_MILLION_USD=0
AGENTFLOW_MAX_CONTEXT_TOKENS=6000
AGENTFLOW_RESERVED_OUTPUT_TOKENS=1200
AGENTFLOW_MAX_TOKENS_PER_EVIDENCE=900
AGENTFLOW_CHECKPOINT_DB_PATH=data/agentflow_checkpoints.sqlite3
AGENTFLOW_TRACE_DIR=data/traces
AGENTFLOW_RUN_WORKSPACE_DIR=data/runs
# Local directory or a Sentence Transformers model id.
AGENTFLOW_EMBED_MODEL_PATH=BAAI/bge-small-zh-v1.5
AGENTFLOW_CORPUS_DIR=data/raw/v2
AGENTFLOW_CORPUS_VERSION=v2
AGENTFLOW_V2_INDEX_ROOT=data/index/v2
AGENTFLOW_V2_CHUNKING_STRATEGY=section_aware
AGENTFLOW_V2_EMBED_MODEL=bge-m3
# Optional local path override; leave blank to load the public model id.
AGENTFLOW_V2_EMBED_MODEL_PATH=
AGENTFLOW_V2_RETRIEVAL_METHOD=cross_encoder
AGENTFLOW_V2_RERANKER_MODEL=BAAI/bge-reranker-base
# Use `local` for JSONL/NumPy indexes or `pgvector` for PostgreSQL persistence.
AGENTFLOW_RETRIEVAL_BACKEND=local
AGENTFLOW_DATABASE_URL=postgresql://agentflow:agentflow@localhost:5432/agentflow
# Required by document indexing and deletion API endpoints.
AGENTFLOW_ADMIN_API_KEY=replace_with_a_random_admin_key
